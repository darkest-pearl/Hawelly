# Copy to .env on the API host and replace every placeholder out of band.
NODE_ENV="production"
HOST="127.0.0.1"
PORT="4000"
CORS_ORIGINS="https://app.example.com"
TRUSTED_BFF_ADDRESSES="127.0.0.1,::1"
DATABASE_URL="postgresql://hawelly:replace-production-password@db.internal:5432/hawelly?sslmode=require"
# Optional: use a dedicated read/backup role rather than the application role.
# BACKUP_DATABASE_URL="postgresql://hawelly_backup:replace-production-password@db.internal:5432/hawelly?sslmode=require"
AUTH_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
AUTH_RATE_LIMIT_PEPPER="replace-with-a-distinct-32-byte-secret"
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_SECONDS="604800"
AUTH_SESSION_ABSOLUTE_TTL_SECONDS="2592000"
AUTH_REGISTRATION_WINDOW_SECONDS="3600"
AUTH_REGISTRATION_IP_MAX_ATTEMPTS="5"
AUTH_LOGIN_WINDOW_SECONDS="900"
AUTH_LOGIN_IP_MAX_FAILURES="10"
AUTH_LOGIN_IDENTIFIER_MAX_FAILURES="5"
AUTH_LOGIN_ACCOUNT_MAX_FAILURES="20"
QUOTE_DEFAULT_EXPIRY_MINUTES="30"
SENDER_RECIPIENT_LIMIT="100"
SENDER_RECIPIENT_CREATE_WINDOW_SECONDS="3600"
SENDER_RECIPIENT_CREATE_MAX="20"
SENDER_ACTIVE_TRANSFER_LIMIT="20"
SENDER_TRANSFER_CREATE_WINDOW_SECONDS="3600"
SENDER_TRANSFER_CREATE_MAX="10"
EVIDENCE_STORAGE_ROOT="/srv/hawelly/evidence"
EVIDENCE_PUBLIC_BASE_URL="https://api.example.com"
EVIDENCE_SIGNING_SECRET="replace-with-a-third-distinct-32-byte-secret"
EVIDENCE_SIGNED_URL_TTL_SECONDS="300"
EVIDENCE_MAX_PROOF_BYTES="8388608"
ANDROID_UPDATE_LATEST_VERSION_CODE="1"
ANDROID_UPDATE_LATEST_VERSION_NAME="1.0.0"
ANDROID_UPDATE_MINIMUM_SUPPORTED_VERSION_CODE="1"
