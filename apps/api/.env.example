# Safe local-development defaults. Copy to .env and adjust locally.
HOST="127.0.0.1"
PORT="4000"
NODE_ENV="development"
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"
TRUSTED_BFF_ADDRESSES="127.0.0.1,::1,::ffff:127.0.0.1"
DATABASE_URL="postgresql://hawelly:replace-locally@127.0.0.1:5432/hawelly?schema=public"
TEST_DATABASE_URL="postgresql://hawelly:replace-locally@127.0.0.1:5432/hawelly_test?schema=public"
AUTH_ACCESS_SECRET="replace-with-at-least-32-random-characters"
AUTH_RATE_LIMIT_PEPPER="replace-with-at-least-32-random-characters"
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_SECONDS="604800"
AUTH_SESSION_ABSOLUTE_TTL_SECONDS="2592000"
AUTH_REGISTRATION_WINDOW_SECONDS="3600"
AUTH_REGISTRATION_IP_MAX_ATTEMPTS="5"
AUTH_LOGIN_WINDOW_SECONDS="900"
AUTH_LOGIN_IP_MAX_FAILURES="10"
AUTH_LOGIN_IDENTIFIER_MAX_FAILURES="5"
AUTH_LOGIN_ACCOUNT_MAX_FAILURES="20"
