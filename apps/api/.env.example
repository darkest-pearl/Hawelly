# Safe local-development defaults. Copy to .env and adjust locally.
HOST="127.0.0.1"
PORT="4000"
NODE_ENV="development"
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"
TRUSTED_BFF_ADDRESSES="127.0.0.1,::1,::ffff:127.0.0.1"
DATABASE_URL="postgresql://hawelly:replace-locally@127.0.0.1:5432/hawelly?schema=public"
TEST_DATABASE_URL="postgresql://hawelly:replace-locally@127.0.0.1:5432/hawelly_test?schema=public"
AUTH_ACCESS_SECRET="replace-with-at-least-32-random-characters"
AUTH_RATE_LIMIT_PEPPER="replace-with-at-least-32-random-characters"
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_SECONDS="604800"
AUTH_SESSION_ABSOLUTE_TTL_SECONDS="2592000"
AUTH_REGISTRATION_WINDOW_SECONDS="3600"
AUTH_REGISTRATION_IP_MAX_ATTEMPTS="5"
AUTH_LOGIN_WINDOW_SECONDS="900"
AUTH_LOGIN_IP_MAX_FAILURES="10"
AUTH_LOGIN_IDENTIFIER_MAX_FAILURES="5"
AUTH_LOGIN_ACCOUNT_MAX_FAILURES="20"
QUOTE_DEFAULT_EXPIRY_MINUTES="30"
EVIDENCE_STORAGE_ROOT=".local/evidence"
EVIDENCE_PUBLIC_BASE_URL="http://127.0.0.1:4000"
EVIDENCE_SIGNING_SECRET="replace-with-a-distinct-32-character-secret"
EVIDENCE_SIGNED_URL_TTL_SECONDS="300"
EVIDENCE_MAX_PROOF_BYTES="8388608"
ANDROID_UPDATE_LATEST_VERSION_CODE="1"
ANDROID_UPDATE_LATEST_VERSION_NAME="1.0.0"
ANDROID_UPDATE_MINIMUM_SUPPORTED_VERSION_CODE="1"
# Configure both values together when an APK update is available.
# ANDROID_UPDATE_DOWNLOAD_URL="https://downloads.example.com/hawelly-android.apk"
# ANDROID_UPDATE_SHA256="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# ANDROID_UPDATE_RELEASE_NOTES="Security and reliability update"
