# Copy to .env on the web host and replace example origins.
NODE_ENV="production"
# A colocated production BFF should call the API over exact loopback. Public
# browser and Android traffic still enters through the HTTPS reverse proxy.
HAWELLY_API_URL="http://127.0.0.1:4000"
HAWELLY_CLIENT_IP_HEADER="x-real-ip"
HAWELLY_WEB_ORIGIN="https://app.example.com"
