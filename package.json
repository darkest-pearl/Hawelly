{
  "name": "hawelly",
  "version": "0.1.0",
  "private": true,
  "description": "Staff-managed cross-border money-transfer coordination platform",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "lodash": "4.18.1"
  },
  "scripts": {
    "postinstall": "npm run db:generate --workspace @hawelly/api",
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev --workspace @hawelly/api\" \"npm run dev --workspace @hawelly/web\"",
    "dev:api": "npm run dev --workspace @hawelly/api",
    "dev:web": "npm run dev --workspace @hawelly/web",
    "lint": "eslint apps/api/src apps/api/scripts apps/web/app apps/web/components apps/web/lib --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @hawelly/api",
    "db:validate": "npm run db:validate --workspace @hawelly/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @hawelly/api",
    "smoke:health": "npm run smoke:health --workspace @hawelly/api",
    "security:client-boundary": "node scripts/securityCheck.mjs",
    "qa:web:capture": "node scripts/captureWeb.mjs",
    "qa:web:m2": "node scripts/captureMilestone2.mjs",
    "check": "npm run db:validate && npm run db:generate && npm run lint && npm run typecheck && npm test && npm run build && npm run security:client-boundary"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "deepmerge-ts": "8.0.2",
    "eslint": "10.9.1",
    "lodash": "4.18.1",
    "playwright-core": "1.62.1",
    "typescript-eslint": "8.68.0"
  }
}
